# Server-only. Copy to .env.local; bootstrap-auth.ps1 supplies local values.
APP_ORIGIN=http://127.0.0.1:3000
# Explicit loopback-only HTTP exception, including local production-build tests.
# Omit/false for deployment; APP_ORIGIN must then use HTTPS.
AUTH_ALLOW_LOCAL_HTTP=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
API_BASE_URL=http://127.0.0.1:8000
