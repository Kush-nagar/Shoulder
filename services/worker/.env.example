# Export in the worker process environment. The worker has no HTTP surface and
# no user identity; it authorizes nothing on a user's behalf. See ADR 0018.
# Dedicated NOBYPASSRLS role created by migration 0005. Never reuse the API or
# migration credentials here.
WORKER_DATABASE_URL=postgresql+psycopg://shoulder_worker:@127.0.0.1:54322/postgres
# Same private bucket as the API. The worker reads sources and writes
# derivatives; it never serves an object to a browser.
R2_ENDPOINT_URL=http://127.0.0.1:9000
R2_BUCKET=shoulder-local
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
WORKER_LOG_LEVEL=INFO
# Resend accepts mail only from a domain verified in the Resend dashboard.
# Keep this sender server-only. Subjects and digest bodies contain no private text.
RESEND_API_KEY=
EMAIL_FROM=Shoulder <updates@example.test>
# Public web origin used for the fixed authenticated product links.
APP_ORIGIN=http://127.0.0.1:3000
# Loopback-only development escape. Production email links require HTTPS.
EMAIL_ALLOW_LOCAL_HTTP=true
