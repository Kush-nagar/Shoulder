# Export in the API process environment. No signing secret is used by the API.
SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
# Same non-privileged local publishable key used by Next.js; enables live session checks.
SUPABASE_PUBLISHABLE_KEY=
# Runtime database role. NOBYPASSRLS, owns no protected table, and is created by
# the Task 4 migration. The operator provisions its password out of band.
DATABASE_URL=postgresql+psycopg://shoulder_api:@127.0.0.1:54322/postgres
# Operator-only initial coach/team bootstrap. At least 32 characters; leave
# unset to disable the endpoint. Never a signup or session credential.
OPERATOR_BOOTSTRAP_TOKEN=
# Optional bootstrap-only connection; never reuse DATABASE_URL or migration credentials.
# Provision shoulder_operator only while bootstrapping, then clear both inputs.
OPERATOR_DATABASE_URL=
