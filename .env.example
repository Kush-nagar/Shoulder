# Run scripts/bootstrap-infra.ps1 to generate .env.local; never use cloud credentials.
MINIO_ROOT_USER=shoulder-local
MINIO_ROOT_PASSWORD=
# Local service addresses. After startup, scripts/bootstrap-auth.ps1 writes
# the server-only web auth environment. See apps/web/.env.example.
# Auth gateway: http://127.0.0.1:54321
# Postgres: 127.0.0.1:54322
# Captured local mail: http://127.0.0.1:54324
# MinIO S3: http://127.0.0.1:9000
# MinIO console: http://127.0.0.1:9001
# Alembic only. Separate from the runtime role above; never used at runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:54322/postgres
# Optional Google sign-in (ADR 0020). Absent, the provider stays inert and the
# local stack still runs; the Google button then fails and email still works.
# The secret reaches GoTrue through the process environment only.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# AI coach (ADR 0021). Server-side only.
OPENROUTER_API_KEY=
AI_COACH_MODEL=deepseek/deepseek-chat
