      "RosterPlayer": {
        "description": "One roster row.\n\n`account_name` is the linked account's display name and comes only from\n`private.team_roster`, the Task 5 helper built for this consumer. It is the\nsole path to another account's name: `user_account` is self-only under RLS.\nIt is never an address.\n\nThat helper hides archived and deletion-pending rows, so `account_name` is\nnull for them even when an account is attached. `account_linked` reads\n`player.user_id` directly and stays truthful for every row, so a screen\nnever calls a linked player unlinked or offers to link them again.",
        "properties": {
          "account_linked": {
            "default": false,
            "title": "Account Linked",
            "type": "boolean"
          },
          "account_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "active_goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "jersey_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jersey Number"
          },
          "position": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "team_id": {
            "format": "uuid",
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "team_id",
          "display_name",
          "jersey_number",
          "position",
          "active"
        ],
        "title": "RosterPlayer",
        "type": "object"
      },
